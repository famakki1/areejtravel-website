---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>;
}

const { content } = Astro.props as Props;
---

<section id="intro" class="main special">
	<header class="major">
		<h2>{content.data.title}</h2>
		{content.data.intro && <p>{content.data.intro}</p>}
	</header>
	<div class="spotlight">
		<div class="content">
			<Fragment set:html={content.body} />
		</div>
		{content.data.image && (
			<span class="image"><img src={content.data.image} alt={content.data.title} /></span>
		)}
	</div>
</section>