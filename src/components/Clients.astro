---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>;
}

const { content } = Astro.props as Props;
const clients = (content.data.clients ?? []) as Array<{ name: string; image: string; link?: string }>;
---

<section id="clients" class="main special">
	<header class="major">
		<h2>{content.data.title}</h2>
		{content.data.subtitle && <p>{content.data.subtitle}</p>}
	</header>
	<div class="client-logo-grid">
		{clients.map((client) => (
			<a class="client-logo-card" href={client.link ?? 'https://areejtravel.com'} target="_blank" rel="noopener noreferrer">
				<img src={client.image} alt={client.name} />
			</a>
		))}
	</div>
</section>