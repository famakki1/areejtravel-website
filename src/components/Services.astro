---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>;
}

const { content } = Astro.props as Props;
const items = (content.data.items ?? []) as Array<{ title: string; description: string; icon?: string; style?: string }>;
---

<section id="services" class="main special">
	<header class="major">
		<h2>{content.data.title}</h2>
		{content.data.subtitle && <p>{content.data.subtitle}</p>}
	</header>
	<ul class="features">
		{items.map((item) => (
			<li>
				<span class={`icon solid major ${item.style ?? 'style1'} ${item.icon ?? 'fa-plane'}`}></span>
				<h3>{item.title}</h3>
				<p>{item.description}</p>
			</li>
		))}
	</ul>
</section>