---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>;
}

const { content } = Astro.props as Props;
const mapEmbedUrl =
  content.data.mapEmbedUrl ??
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3576.8675492867305!2d50.20748491028754!3d26.298393476922765!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e49e84417a1c2cf%3A0xe25c1f4bab15f968!2sAreej%20Travel%20%26%20Tours!5e0!3m2!1sen!2sau!4v1785232491257!5m2!1sen!2sau';
const mapOpenUrl =
  content.data.mapOpenUrl ??
  'https://www.google.com/maps?q=Prince+Fawaz+Street,+Al-Khobar+34426,+Saudi+Arabia';
---

<section id="location" class="main special location-map">
	<header class="major">
		<h2>{content.data.title}</h2>
		{content.data.subtitle && <p>{content.data.subtitle}</p>}
	</header>
	<div class="map-frame">
		<iframe
			title="Areej Travel and Tours location map"
			src={mapEmbedUrl}
			allowfullscreen
			loading="lazy"
			referrerpolicy="strict-origin-when-cross-origin"
		></iframe>
	</div>
	<p><a href={mapOpenUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps</a></p>
</section>