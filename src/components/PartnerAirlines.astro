---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'home'>;
}

const { content } = Astro.props as Props;
const airlines = (content.data.airlines ?? []) as Array<{ name: string; image: string }>;
const shuffleArray = <T,>(items: T[]) => {
  const shuffled = [...items];
  for (let i = shuffled.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
};
const shuffledAirlines = shuffleArray(airlines);
const rowSize = Math.ceil(shuffledAirlines.length / 3);
const rows = [
  shuffledAirlines.slice(0, rowSize),
  shuffledAirlines.slice(rowSize, rowSize * 2),
  shuffledAirlines.slice(rowSize * 2),
];
---

<section id="airlines" class="main special">
  <header class="major">
    <h2>{content.data.title}</h2>
    <p>{content.data.subtitle}</p>
  </header>

  <div class="partner-grid-container">
    {rows.map((row, index) => (
      <div class="partner-row-wrapper">
        <div
          class={`partner-track direction-${index % 2 === 0 ? 'left' : 'right'} marquee-row`}
          data-row-index={index}
          style={{ '--row-width': '0px' }}
        >
          <div class="marquee-group">
            {row.map((airline) => (
              <img src={airline.image} alt={airline.name} />
            ))}
          </div>
          <div class="marquee-group" aria-hidden="true">
            {row.map((airline) => (
              <img src={airline.image} alt={airline.name} />
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function initializeMarquees() {
    const rows = document.querySelectorAll<HTMLElement>('.marquee-row');

    rows.forEach((row) => {
      const firstGroup = row.querySelector<HTMLElement>('.marquee-group');
      if (!firstGroup) return;

      const width = firstGroup.getBoundingClientRect().width;
      row.style.setProperty('--row-width', `${width}px`);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeMarquees);
  } else {
    initializeMarquees();
  }

  window.addEventListener('load', initializeMarquees);
</script>